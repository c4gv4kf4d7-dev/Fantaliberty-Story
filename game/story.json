  "scenes": {
    "arrivo": {
      "title": "Atto 1 — L'arrivo",
      "bg": "esterno_vialetto",
      "bgFx": "zoomlento",
      "uccelli": 8,
      "steps": [
        {
          "t": "logo",
          "img": "ui/logo_studio.png",
          "nero": 1000,
          "accensione": 1000,
          "fisso": 2000,
          "uscita": 900
        },
        {
          "t": "boot",
          "blocchi": 9,
          "ms": 2200,
          "cursore": 1600
        },
        {
          "t": "title",
          "lines": [
            {
              "text": "Cupertino, California.",
              "pausa": 950
            },
            {
              "text": "Apple Park.",
              "pausa": 1150
            },
            {
              "text": "-1 ora al Keynote.",
              "big": true
            }
          ]
        },
        {
          "t": "fx",
          "name": "lights"
        },
        {
          "t": "wait",
          "ms": 6200
        }
      ],
      "next": "ingresso",
      "foglie": 7,
      "pulviscolo": 14
    },
    "registrazione": {
      "title": "Atto 1 — Registrazione",
      "bg": "esterno_ingresso",
      "bgFx": "blur",
      "terminal": [
        {
          "key": "NOME:",
          "var": "nome"
        },
        {
          "key": "GENERE:",
          "var": "genere",
          "map": {
            "m": "M",
            "f": "F",
            "x": "N"
          }
        },
        {
          "key": "ANNI:",
          "var": "anni",
          "map": {
            "0": "<1",
            "1": "1-5",
            "2": "5-10",
            "3": "10+"
          }
        },
        {
          "key": "",
          "var": "__ok"
        }
      ],
      "steps": [
        {
          "t": "show",
          "who": "lucas",
          "body": "neutro"
        },
        {
          "t": "prop",
          "id": "mac_terminale",
          "show": true,
          "size": "64%",
          "top": "4%"
        },
        {
          "t": "wait",
          "ms": 600
        },
        {
          "t": "input",
          "who": "lucas",
          "var": "nome",
          "max": 14,
          "text": "Registriamoti al terminale. Come ti chiami?"
        },
        {
          "t": "choice",
          "who": "lucas",
          "var": "genere",
          "text": "Perfetto, {NOME}. Come preferisci che mi rivolga a te?",
          "options": [
            {
              "label": "Maschile",
              "value": "m"
            },
            {
              "label": "Femminile",
              "value": "f"
            },
            {
              "label": "Neutro",
              "value": "x"
            }
          ]
        },
        {
          "t": "choice",
          "who": "lucas",
          "var": "anni",
          "text": "Annotato. E da quanto tempo lavori in Apple?",
          "options": [
            {
              "label": "Meno di 1 anno",
              "say": "Meno di un anno",
              "value": "0"
            },
            {
              "label": "Da 1 a 5 anni",
              "say": "Da 1 a 5 anni",
              "value": "1"
            },
            {
              "label": "Da 5 a 10 anni",
              "say": "Da 5 a 10 anni",
              "value": "2"
            },
            {
              "label": "Piu' di 10 anni",
              "say": "Piu' di 10 anni",
              "value": "3"
            }
          ]
        },
        {
          "t": "set",
          "var": "__ok",
          "value": "> BADGE IN STAMPA"
        },
        {
          "t": "wait",
          "ms": 900
        },
        {
          "t": "prop",
          "show": false
        }
      ],
      "next": "badge",
      "uccelli": 0,
      "foglie": 2,
      "pulviscolo": 8
    },
    "ritardo_ceo": {
      "title": "Atto 2 — Il camerino",
      "bg": "camerino",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "wait",
          "ms": 400
        },
        {
          "t": "show",
          "who": "susan",
          "body": "in_piedi",
          "head": "ansia"
        },
        {
          "t": "say",
          "who": "susan",
          "text": "[BOZZA] {NOME}? {NOME}! Meno male. Abbiamo un problema: Ternus e' in ritardo e il keynote inizia tra venti minuti."
        },
        {
          "t": "say",
          "who": "susan",
          "text": "[BOZZA] No, non hai capito. TU adesso vieni con me dietro le quinte. Muoviti!"
        },
        {
          "t": "choice",
          "who": "susan",
          "var": "tono",
          "text": "[BOZZA] Allora? Che facciamo?",
          "options": [
            {
              "label": "Ti seguo, andiamo",
              "value": "sfacciato",
              "react": {
                "level": "expr",
                "head": "positiva"
              }
            },
            {
              "label": "Aspetta, chi sei?",
              "value": "prudente",
              "react": {
                "level": "expr",
                "head": "scettica"
              }
            }
          ]
        },
        {
          "t": "react",
          "level": "pose",
          "body": "spinta",
          "head": "ansia"
        },
        {
          "t": "say",
          "who": "susan",
          "text": "[BOZZA] ...ne riparliamo dopo. Corri!"
        }
      ],
      "next": "lobby",
      "dissolvenza": true
    },
    "lobby": {
      "title": "Atto 3 — La lobby",
      "bg": "lobby",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "show",
          "who": "francesca",
          "body": "benvenuto"
        },
        {
          "t": "say",
          "who": "francesca",
          "text": "[BOZZA] Ehi, calma. Prima che ti buttino sul palco, ti faccio vedere com'e' fatto questo posto."
        },
        {
          "t": "choice",
          "who": "francesca",
          "var": "sezione",
          "text": "[BOZZA] Da dove vuoi partire?",
          "options": [
            {
              "label": "Il gioco delle previsioni",
              "value": "gioco",
              "goto": "backstage"
            },
            {
              "label": "I premi",
              "value": "premi",
              "goto": "premi"
            },
            {
              "label": "Il quiz storico",
              "value": "quiz",
              "goto": "quiz"
            }
          ]
        }
      ]
    },
    "backstage": {
      "title": "Atto 4 — Backstage / regia",
      "bg": "sala_teatro",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "show",
          "who": "martha"
        },
        {
          "t": "say",
          "who": "martha",
          "text": "[BOZZA] Cuffie, microfono, tre minuti. Qui si decide come va lo show: le tue previsioni sul keynote."
        },
        {
          "t": "say",
          "who": "martha",
          "text": "[BOZZA] (qui va il blocco previsioni FantaLiberty. Regola: le reazioni degli NPC e della platea seguono il TONO della risposta, mai il contenuto del pronostico.)"
        }
      ],
      "next": "finale"
    },
    "quiz": {
      "title": "Atto 4 — Quiz storico",
      "bg": "lobby",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "show",
          "who": "veterano"
        },
        {
          "t": "say",
          "who": "veterano",
          "text": "[BOZZA] Io c'ero nel 2007. Vediamo se te la cavi."
        },
        {
          "t": "choice",
          "who": "veterano",
          "var": "quiz1",
          "text": "[BOZZA] In che anno e' stato presentato il primo iPhone?",
          "options": [
            {
              "label": "2005",
              "value": "no"
            },
            {
              "label": "2007",
              "value": "si",
              "react": {
                "level": "expr",
                "head": "compiaciuto"
              }
            },
            {
              "label": "2009",
              "value": "no"
            }
          ]
        },
        {
          "t": "say",
          "who": "veterano",
          "text": "[BOZZA] (qui la valutazione della risposta e l'assegnazione dei punti)"
        }
      ],
      "next": "premi"
    },
    "premi": {
      "title": "Atto 4 — Premi",
      "bg": "lobby",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "show",
          "who": "premi",
          "body": "tada",
          "head": "positivo",
          "pop": true
        },
        {
          "t": "fx",
          "name": "flash"
        },
        {
          "t": "say",
          "who": "premi",
          "text": "[BOZZA] Ta-daaa! Questi te li sei {g:guadagnato|guadagnata|guadagnati}, {NOME}."
        }
      ],
      "next": "finale"
    },
    "finale": {
      "title": "Finale",
      "bg": "lobby",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "show",
          "who": "lucas",
          "body": "felice",
          "pop": true
        },
        {
          "t": "say",
          "who": "lucas",
          "text": "[BOZZA] E' andata alla grande, {NOME}! Il tuo risultato e' salvato: ci vediamo in classifica."
        },
        {
          "t": "end"
        }
      ]
    },
    "ingresso": {
      "title": "Atto 1 — All'ingresso",
      "bg": "esterno_ingresso",
      "dissolvenza": true,
      "uccelli": 2,
      "steps": [
        {
          "t": "wait",
          "ms": 1600
        },
        {
          "t": "show",
          "who": "lucas",
          "body": "neutro"
        },
        {
          "t": "wait",
          "ms": 600
        },
        {
          "t": "say",
          "who": "lucas",
          "text": "Ciao! Io sono Lucas... ti stavamo aspettando allo Steve Jobs Theater!"
        }
      ],
      "next": "registrazione",
      "foglie": 3,
      "pulviscolo": 10
    },
    "badge": {
      "title": "Atto 1 — Il badge",
      "bg": "esterno_ingresso",
      "steps": [
        {
          "t": "fx",
          "name": "flash"
        },
        {
          "t": "show",
          "who": "lucas",
          "body": "felice",
          "pop": true
        },
        {
          "t": "say",
          "who": "lucas",
          "text": "Ecco il tuo badge, {NOME}. Tienilo al collo e non perderlo: qui dentro senza quello non vai da nessuna parte."
        },
        {
          "t": "say",
          "who": "lucas",
          "by": "anni",
          "text": {
            "0": "Primo anno, eh? Allora questo e' il tuo primo Keynote. Guardati intorno stasera: e' una cosa che ti ricordi per sempre.",
            "1": "Qualche anno alle spalle: abbastanza per sapere come gira, non abbastanza da {g:esserti stufato|esserti stufata|averne abbastanza}. Il momento migliore, secondo me.",
            "2": "Cinque, dieci anni... tu i Keynote li hai gia' visti. Ma da qui dentro e' un'altra storia, fidati.",
            "3": "Piu' di dieci anni. Tu c'eri quando certe cose le annunciavano ancora su un palco piccolo. Stasera goditela.",
            "*": "Comunque sia andata finora, stasera si riparte da zero come tutti."
          }
        },
        {
          "t": "say",
          "who": "lucas",
          "text": "{g:Benvenuto|Benvenuta|Ti do il benvenuto} allo Steve Jobs Theater. Adesso pero' non restare qui {g:impalato|impalata|fermo li'}: ti aspettano dentro."
        }
      ],
      "next": "ritardo_ceo",
      "foglie": 3,
      "pulviscolo": 10
    }
  }
}
