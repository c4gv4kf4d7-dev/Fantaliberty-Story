    "aggancio": {
      "title": "S2 — L'aggancio",
      "bg": "lobby_z1_tenda",
      "_nota": "La scena si apre ancora sulla tenda della lobby: e' quella che si divide in due. Dietro c'e' bg_sala_teatro — lo script master lo chiama bg_sala_ingresso_superiore, e' lo stesso file: la sala vista dall'alto del corridoio, con il palco in fondo.",
      "steps": [
        {
          "t": "hide"
        },
        {
          "t": "sipario",
          "davanti": "lobby_z1_tenda",
          "dietro": "sala_teatro",
          "ms": 1700
        },
        {
          "t": "show",
          "who": "susan",
          "body": "panico_telefoni",
          "height": "9%",
          "bottom": "48%",
          "right": "45%"
        },
        {
          "t": "wait",
          "ms": 700
        },
        {
          "t": "say",
          "who": "susan",
          "text": "Ehi TU! Si', tu! Scendi!"
        },
        {
          "t": "carrellata",
          "id": "discesa_palco"
        },
        {
          "t": "bg",
          "id": "sala_teatro",
          "fx": "zoom"
        },
        {
          "t": "show",
          "who": "susan",
          "body": "mani_capelli",
          "pop": true
        },
        {
          "t": "say",
          "who": "susan",
          "text": "Ascolta. Il CEO e' bloccato in tangenziale, no in autostrada... insomma e' fermo."
        },
        {
          "t": "say",
          "who": "susan",
          "text": "Tra quaranta minuti c'e' la prova generale. Con la regia, le luci, i grafici, tutto. Se non la facciamo, stasera non si va in onda."
        },
        {
          "t": "say",
          "who": "susan",
          "text": "Tu sei l'unico essere umano in questa sala. Congratulazioni: fai l'host tu."
        },
        {
          "t": "choice",
          "who": "susan",
          "var": "sfacciato",
          "_nota": "Nessun effetto su punteggio o stato: cambia solo il tono. L'opzione sfacciata abilita chr_susan_carponi in S5.",
          "text": "Allora?",
          "options": [
            {
              "label": "Io? Ma non ho studiato niente!",
              "value": false
            },
            {
              "label": "Finalmente qualcuno se n'e' accorto.",
              "value": true,
              "react": {
                "level": "micro"
              }
            },
            {
              "label": "(annuire in silenzio)",
              "value": false
            }
          ]
        },
        {
          "t": "bg",
          "id": "backstage_corridoio",
          "dissolvenza": true
        },
        {
          "t": "show",
          "who": "susan",
          "body": "indica_camerino"
        },
        {
          "t": "say",
          "who": "susan",
          "text": "Ottimo, hai detto si'."
        },
        {
          "t": "say",
          "who": "susan",
          "text": "Camerino, ultima porta a destra. Hai quattro minuti e ne hai gia' persi due."
        }
      ],
      "next": "backstage"
    },
