{
  "meta": {
    "title": "FantaLiberty — Nexus",
    "version": "0.3.0",
    "start": "arrivo",
    "assetBase": "assets/",
    "genderVar": "genere",
    "genderOrder": ["m", "f", "x"],
    "note": "Formato: iPhone portrait 390x844. Il terzo inferiore e' area dialogo."
  },

  "assets": {
    "bg": {
      "esterno_teatro": "bg/bg_esterno_teatro.webp",
      "lobby": "bg/bg_lobby.webp",
      "sala_teatro": "bg/bg_sala_teatro.webp"
    },
    "props": {
      "mac_terminale": "props/prop_mac_terminale.png"
    },
    "chars": {}
  },

  "cast": {
    "lucas": {
      "name": "Lucas",
      "defaultBody": "neutro",
      "defaultHead": "neutro",
      "bodies": {
        "neutro": "chars/chr_lucas_neutro.png",
        "felice": "chars/chr_lucas_felice.png"
      },
      "heads": {},
      "_nota": "Sprite unico (prototipo). I personaggi nuovi vanno consegnati con corpo e testa separati: 'bodies' = pose, 'heads' = espressioni, 'neck' = ancoraggio."
    },
    "susan": {
      "name": "Susan",
      "defaultBody": "in_piedi",
      "defaultHead": "ansia",
      "neck": { "x": "50%", "y": "3%", "w": "32%" },
      "bodies": {
        "in_piedi": "chars/chr_susan_corpo_in_piedi@3x.webp",
        "spinta": "chars/chr_susan_corpo_spinta@3x.webp"
      },
      "heads": {
        "neutro": "chars/chr_susan_testa_neutro@3x.webp",
        "ansia": "chars/chr_susan_testa_ansia@3x.webp",
        "sorpresa": "chars/chr_susan_testa_sorpresa@3x.webp",
        "scettica": "chars/chr_susan_testa_scettica@3x.webp",
        "positiva": "chars/chr_susan_testa_positiva@3x.webp"
      }
    },
    "maurice": {
      "name": "Maurice",
      "defaultBody": "in_piedi",
      "defaultHead": "neutro",
      "neck": { "x": "50%", "y": "3%", "w": "32%" },
      "bodies": { "in_piedi": "chars/chr_maurice_corpo_in_piedi@3x.webp" },
      "heads": {
        "neutro": "chars/chr_maurice_testa_neutro@3x.webp",
        "positivo": "chars/chr_maurice_testa_positivo@3x.webp",
        "sorpreso": "chars/chr_maurice_testa_sorpreso@3x.webp"
      }
    },
    "martha": {
      "name": "Martha",
      "defaultBody": "in_piedi",
      "defaultHead": "neutro",
      "neck": { "x": "50%", "y": "3%", "w": "32%" },
      "bodies": { "in_piedi": "chars/chr_martha_corpo_in_piedi@3x.webp" },
      "heads": {
        "neutro": "chars/chr_martha_testa_neutro@3x.webp",
        "positivo": "chars/chr_martha_testa_positivo@3x.webp"
      }
    },
    "veterano": {
      "name": "Veterano",
      "defaultBody": "seduto",
      "defaultHead": "neutro",
      "neck": { "x": "50%", "y": "5%", "w": "32%" },
      "bodies": { "seduto": "chars/chr_veterano_corpo_seduto@3x.webp" },
      "heads": {
        "neutro": "chars/chr_veterano_testa_neutro@3x.webp",
        "compiaciuto": "chars/chr_veterano_testa_compiaciuto@3x.webp",
        "scettico": "chars/chr_veterano_testa_scettico@3x.webp"
      }
    },
    "premi": {
      "name": "???",
      "defaultBody": "in_piedi",
      "defaultHead": "neutro",
      "neck": { "x": "50%", "y": "3%", "w": "32%" },
      "bodies": {
        "in_piedi": "chars/chr_premi_corpo_in_piedi@3x.webp",
        "tada": "chars/chr_premi_corpo_tada@3x.webp"
      },
      "heads": {
        "neutro": "chars/chr_premi_testa_neutro@3x.webp",
        "positivo": "chars/chr_premi_testa_positivo@3x.webp"
      }
    }
  },

  "avatar": {
    "path": "avatar/avt_{slot}_{option}@3x.webp",
    "layers": ["bottom", "top", "scarpe", "testa"],
    "slots": [
      {
        "id": "testa", "label": "Testa",
        "options": [{ "id": "a", "label": "1" }, { "id": "b", "label": "2" }, { "id": "c", "label": "3" }, { "id": "d", "label": "4" }]
      },
      {
        "id": "top", "label": "Sopra",
        "options": [{ "id": "a", "label": "1" }, { "id": "b", "label": "2" }, { "id": "c", "label": "3" }, { "id": "d", "label": "4" }]
      },
      {
        "id": "bottom", "label": "Sotto",
        "options": [{ "id": "a", "label": "1" }, { "id": "b", "label": "2" }, { "id": "c", "label": "3" }, { "id": "d", "label": "4" }]
      },
      {
        "id": "scarpe", "label": "Scarpe",
        "options": [{ "id": "a", "label": "1" }, { "id": "b", "label": "2" }, { "id": "c", "label": "3" }, { "id": "d", "label": "4" }]
      }
    ]
  },

  "vars": {
    "nome": "",
    "genere": null,
    "anni": null,
    "punti": 0
  },

  "scenes": {

    "arrivo": {
      "title": "Atto 1 — L'arrivo",
      "bg": "esterno_teatro",
      "bgFx": "zoom",
      "steps": [
        { "t": "wait", "ms": 2100 },
        { "t": "show", "who": "lucas", "body": "neutro" },
        { "t": "wait", "ms": 500 },
        { "t": "say", "who": "lucas", "text": "Ciao! Io sono Lucas... ti stavamo aspettando allo Steve Jobs Theater!" }
      ],
      "next": "registrazione"
    },

    "registrazione": {
      "title": "Atto 1 — Registrazione",
      "bg": "esterno_teatro",
      "bgFx": "blur",
      "terminal": [
        { "key": "NOME:", "var": "nome" },
        { "key": "GENERE:", "var": "genere", "map": { "m": "MASCHILE", "f": "FEMMINILE", "x": "NEUTRO" } },
        { "key": "ANZIANITA':", "var": "anni", "map": { "0": "<1 ANNO", "1": "1-5 ANNI", "2": "5-10 ANNI", "3": "10+ ANNI" } },
        { "key": "", "var": "__ok" }
      ],
      "steps": [
        { "t": "show", "who": "lucas", "body": "neutro", "height": "32%", "bottom": "37%" },
        { "t": "prop", "id": "mac_terminale", "show": true },
        { "t": "wait", "ms": 600 },
        {
          "t": "input", "who": "lucas", "var": "nome", "max": 14,
          "text": "Registriamoti al terminale. Come ti chiami?"
        },
        {
          "t": "choice", "who": "lucas", "var": "genere",
          "text": "Perfetto, {NOME}. Come preferisci che mi rivolga a te?",
          "options": [
            { "label": "Maschile", "value": "m" },
            { "label": "Femminile", "value": "f" },
            { "label": "Neutro", "value": "x" }
          ]
        },
        {
          "t": "choice", "who": "lucas", "var": "anni",
          "text": "Annotato. E da quanto tempo lavori in Apple?",
          "options": [
            { "label": "Meno di 1 anno", "say": "Meno di un anno", "value": "0" },
            { "label": "Da 1 a 5 anni", "say": "Da 1 a 5 anni", "value": "1" },
            { "label": "Da 5 a 10 anni", "say": "Da 5 a 10 anni", "value": "2" },
            { "label": "Piu' di 10 anni", "say": "Piu' di 10 anni", "value": "3" }
          ]
        },
        { "t": "set", "var": "__ok", "value": "> REGISTRAZIONE OK" },
        { "t": "wait", "ms": 700 },
        { "t": "prop", "show": false },
        {
          "t": "avatar", "who": "lucas", "confirm": "Sono io",
          "text": "Ultima cosa: il badge vuole la tua foto. Costruisci il tuo avatar."
        }
      ],
      "next": "benvenuto"
    },

    "benvenuto": {
      "title": "Atto 1 — Benvenuto",
      "bg": "esterno_teatro",
      "steps": [
        { "t": "fx", "name": "flash" },
        { "t": "fx", "name": "unblur" },
        { "t": "show", "who": "lucas", "body": "felice", "pop": true },
        {
          "t": "say", "who": "lucas",
          "text": "{g:Benvenuto|Benvenuta|Ti do il benvenuto} allo Steve Jobs Theater, {NOME}! Grazie, ben fatto."
        },
        {
          "t": "say", "who": "lucas",
          "text": "{g:Ti sei registrato senza intoppi.|Ti sei registrata senza intoppi.|La registrazione e' andata a buon fine.} {label:anni} in Apple: esperienza che qui conta parecchio."
        },
        {
          "t": "say", "who": "lucas",
          "text": "Il badge e' attivo. {g:Direi che sei pronto.|Direi che sei pronta.|Direi che hai tutto quello che serve.} Puoi entrare... che aspetti?"
        }
      ],
      "next": "ritardo_ceo"
    },

    "ritardo_ceo": {
      "title": "Atto 2 — Il ritardo del CEO",
      "bg": "sala_teatro",
      "steps": [
        { "t": "hide" },
        { "t": "wait", "ms": 400 },
        { "t": "show", "who": "susan", "body": "in_piedi", "head": "ansia" },
        { "t": "say", "who": "susan", "text": "[BOZZA] {NOME}? {NOME}! Meno male. Abbiamo un problema: Ternus e' in ritardo e il keynote inizia tra venti minuti." },
        { "t": "say", "who": "susan", "text": "[BOZZA] No, non hai capito. TU adesso vieni con me dietro le quinte. Muoviti!" },
        {
          "t": "choice", "who": "susan", "var": "tono",
          "text": "[BOZZA] Allora? Che facciamo?",
          "options": [
            { "label": "Ti seguo, andiamo", "value": "sfacciato", "react": { "level": "expr", "head": "positiva" } },
            { "label": "Aspetta, chi sei?", "value": "prudente", "react": { "level": "expr", "head": "scettica" } }
          ]
        },
        { "t": "react", "level": "pose", "body": "spinta", "head": "ansia" },
        { "t": "say", "who": "susan", "text": "[BOZZA] ...ne riparliamo dopo. Corri!" }
      ],
      "next": "lobby"
    },

    "lobby": {
      "title": "Atto 3 — La lobby",
      "bg": "lobby",
      "steps": [
        { "t": "hide" },
        { "t": "show", "who": "maurice" },
        { "t": "say", "who": "maurice", "text": "[BOZZA] Ehi, calma. Prima che ti buttino sul palco, ti faccio vedere com'e' fatto questo posto." },
        {
          "t": "choice", "who": "maurice", "var": "sezione",
          "text": "[BOZZA] Da dove vuoi partire?",
          "options": [
            { "label": "Il gioco delle previsioni", "value": "gioco", "goto": "backstage" },
            { "label": "I premi", "value": "premi", "goto": "premi" },
            { "label": "Il quiz storico", "value": "quiz", "goto": "quiz" }
          ]
        }
      ]
    },

    "backstage": {
      "title": "Atto 4 — Backstage / regia",
      "bg": "sala_teatro",
      "steps": [
        { "t": "hide" },
        { "t": "show", "who": "martha" },
        { "t": "say", "who": "martha", "text": "[BOZZA] Cuffie, microfono, tre minuti. Qui si decide come va lo show: le tue previsioni sul keynote." },
        { "t": "say", "who": "martha", "text": "[BOZZA] (qui va il blocco previsioni FantaLiberty. Regola: le reazioni degli NPC e della platea seguono il TONO della risposta, mai il contenuto del pronostico.)" }
      ],
      "next": "finale"
    },

    "quiz": {
      "title": "Atto 4 — Quiz storico",
      "bg": "lobby",
      "steps": [
        { "t": "hide" },
        { "t": "show", "who": "veterano" },
        { "t": "say", "who": "veterano", "text": "[BOZZA] Io c'ero nel 2007. Vediamo se te la cavi." },
        {
          "t": "choice", "who": "veterano", "var": "quiz1",
          "text": "[BOZZA] In che anno e' stato presentato il primo iPhone?",
          "options": [
            { "label": "2005", "value": "no" },
            { "label": "2007", "value": "si", "react": { "level": "expr", "head": "compiaciuto" } },
            { "label": "2009", "value": "no" }
          ]
        },
        { "t": "say", "who": "veterano", "text": "[BOZZA] (qui la valutazione della risposta e l'assegnazione dei punti)" }
      ],
      "next": "premi"
    },

    "premi": {
      "title": "Atto 4 — Premi",
      "bg": "lobby",
      "steps": [
        { "t": "hide" },
        { "t": "show", "who": "premi", "body": "tada", "head": "positivo", "pop": true },
        { "t": "fx", "name": "flash" },
        { "t": "say", "who": "premi", "text": "[BOZZA] Ta-daaa! Questi te li sei {g:guadagnato|guadagnata|guadagnati}, {NOME}." }
      ],
      "next": "finale"
    },

    "finale": {
      "title": "Finale",
      "bg": "lobby",
      "steps": [
        { "t": "hide" },
        { "t": "show", "who": "lucas", "body": "felice", "pop": true },
        { "t": "say", "who": "lucas", "text": "[BOZZA] E' andata alla grande, {NOME}! Il tuo risultato e' salvato: ci vediamo in classifica." },
        { "t": "end" }
      ]
    }
  }
}
